# ==============================================================================
# Synapse AI Creator Workbench - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your values, or configure keys directly
# inside the app's Settings panel (Gear icon in top navigation).
# 复制此文件为 `.env` 并填写对应配置，或在应用运行后点击右上角「设置」直接配置。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration (Gemini API 密钥与模型)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# 获取密钥地址：https://aistudio.google.com/
# Formats: AQ.xxx... or AIzaSyxxx...
# 保持为空时，启动后可在应用内「设置 > 模型与 API 密钥」中手动输入并持久化存储在本地。
GEMINI_API_KEY=""

# Recommended default model: gemini-3.8-flash
# Supported models:
#   - gemini-3.8-flash (Recommended default / 推荐主力模型)
#   - gemini-4-hydrogen (Reasoning / 深度推理)
#   - gemini-4-argon (Ultra-fast / 极速响应)
#   - gemini-3.1-flash-lite (Cost-effective / 轻量经济)
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 2. Server Configuration (服务端与端口配置)
# ------------------------------------------------------------------------------
# Local embedded backend server port (Default: 3000).
# The app automatically detects port collisions (EADDRINUSE) and increments if occupied.
# 本地服务端口，默认 3000。若被占用，程序会自动智能避让并递增重试。
PORT=3000

# Runtime environment (development / production)
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. Optional Firebase Cloud Sync (可选：云端多端同步与网盘授权)
# ------------------------------------------------------------------------------
# If left empty, Synapse runs purely in local-first mode with zero external telemetry.
# 若留空，程序默认以全本地离线优先模式运行，数据仅存储在本地 Documents/Synapse_Workspace。
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
